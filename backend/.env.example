# AI question generation — any subset works; only configured providers show in the UI.
# Copy to backend/.env (local) and set the same names in Vercel project settings.
#
# You don't have to edit this file: the AI Generate page has a key manager
# (AI model section → "Manage API keys") that validates a pasted key against
# the vendor and stores it server-side. Environment variables below take
# precedence over keys saved in the UI.

# OpenCode Console — one key for GPT, Claude, Gemini, Grok, DeepSeek, Qwen, free models…
OPENCODE_API_KEY=

# Seed for the UI's model picker (optional). Only a default — every provider's
# full list stays selectable. Ignored if the model isn't offered or can't be
# called from a server (OpenCode's *-free models only run in its own app).
# AI_DEFAULT_MODEL=gemini-3-flash

# Direct vendor keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=          # (GOOGLE_API_KEY also accepted)
GROQ_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
TOGETHER_API_KEY=
CEREBRAS_API_KEY=

# Aggregator — thousands of models incl. free tiers
OPENROUTER_API_KEY=

# Local models — set the host to enable the provider (no API key needed)
# OLLAMA_HOST=http://127.0.0.1:11434
# LMSTUDIO_HOST=http://localhost:1234

# OCR (tesseract.js) — which languages to download on first use: eng, ben.
# The UI picks per upload ("eng+ben" for mixed Bangla/English pages).
# OCR_MAX_PAGES=150   # page cap for ONE scanned PDF before OCR stops
