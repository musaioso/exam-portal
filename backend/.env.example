# Backend environment (copy to .env for local dev)
PORT=4000

# Comma-separated list of allowed browser origins.
# Local dev + your Vercel URL(s), e.g.:
# CORS_ORIGIN=http://localhost:5173,https://mcq-studio.vercel.app
CORS_ORIGIN=http://localhost:5173

# Where the local SQLite file is stored (used only when no Turso DB is set).
# Local dev: data/mcq.db
DB_PATH=data/mcq.db

# --- Persistent database (production) -------------------------------------
# Set these to store data in a Turso (libSQL) database so it survives redeploys
# and is shared by every serverless instance. Leave unset for local dev (a file
# SQLite database is used instead).
#
# IMPORTANT on Vercel: prefer the MCQ_* names below. Vercel's Turso integration
# injects a deployment-scoped TURSO_DATABASE_URL (a brand-new, empty database on
# every deploy), which made all data disappear after each deployment. The MCQ_*
# names are never managed by that integration, so the app always uses the same
# database. TURSO_*/LIBSQL_* still work as a fallback.
# MCQ_DATABASE_URL=libsql://your-db-name.turso.io
# MCQ_AUTH_TOKEN=eyJhbGciOi...
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=eyJhbGciOi...

# Change this in production. All existing login tokens become invalid when it
# changes, so everyone simply signs in again.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=mcq-secret-change-me
