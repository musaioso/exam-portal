# Backend environment (copy to .env for local dev)
PORT=4000

# Comma-separated list of allowed browser origins.
# Local dev + your Vercel URL(s), e.g.:
# CORS_ORIGIN=http://localhost:5173,https://mcq-studio.vercel.app
CORS_ORIGIN=http://localhost:5173

# Where the SQLite file is stored.
# Local dev: data/mcq.db
# Render (with a persistent disk mounted at /var/data): /var/data/mcq.db
DB_PATH=data/mcq.db

# Change this in production. All existing login tokens become invalid when it changes.
JWT_SECRET=mcq-secret-change-me
